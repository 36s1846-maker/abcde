    </div>

    <!-- í•˜ë‹¨ ì¶œì²˜ ë° ìœ ì˜ì‚¬í•­ -->
    <footer>
        <p><strong>ë°ì´í„° ì¶œì²˜:</strong> World Bank Open Data (WB API), ILOSTAT (êµ­ì œë…¸ë™ê¸°êµ¬ API), IMF DataMapper API (WEO), Worldwide Governance Indicators (WGI)</p>
        <p><strong>ì¡°íšŒ ê¸°ì¤€:</strong> ì„ íƒëœ êµ­ê°€, ì§€í‘œ, ì¡°íšŒ ì—°ë„ ë²”ìœ„ ë‚´ ê³µì‹ í†µê³„ ì‹¤ì  ë° IMF / ì„ í˜• ì¶”ì„¸ 2034 ì˜ˆì¸¡ ë°ì´í„° ì—°ë™</p>
        <p><strong>ë¶„ì„ ìœ ì˜ì‚¬í•­:</strong> íŠ¹ì • ì—°ë„ì˜ ê²½ì œÂ·ë…¸ë™ ì§€í‘œ ë³€í™”ê°€ ì›”ë“œì»µ ê°œìµœì˜ ë‹¨ì¼ ì¸ê³¼íš¨ê³¼ë¼ê³  ë‹¨ì •í•  ìˆ˜ ì—†ìŠµë‹ˆë‹¤. ìœ ê°€ ë³€ë™, ì½”ë¡œë‚˜19 ì˜í–¥, ì‚¬ìš°ë””í™”(Saudization) ë…¸ë™ ì •ì±… ë“± êµ­ê°€ë³„ ë§¥ë½ì„ ë³µí•©ì ìœ¼ë¡œ ê³ ë ¤í•´ì•¼ í•©ë‹ˆë‹¤.</p>
        <p><strong>ë¯¸ëž˜ ì „ë§ ì•ˆë‚´:</strong> 2026~2034ë…„ ë°ì´í„° ì¤‘ IMF ì¶”ì •ì¹˜ ë° ì„ í˜• ëª¨ë¸ ì˜ˆì¸¡ê°’ì€ í™•ì •ëœ í†µê³„ê°€ ì•„ë‹ˆë©°, 2034 ì‚¬ìš°ë””ì•„ë¼ë¹„ì•„ ì›”ë“œì»µ ì‚¬ì „ ì‹œë‚˜ë¦¬ì˜¤ ë¶„ì„ ìš©ë„ë¡œ í™œìš©ë©ë‹ˆë‹¤.</p>
    </footer>

    <script>
        /**
         * 1. 15ê°œ ë‹¤ë©´ ì§€í‘œ ë°ì´í„°ë² ì´ìŠ¤ ì •ì˜ (ê²½ì œ, ì‚¬íšŒ/ë…¸ë™, ì •ì¹˜/ì œë„, ì¸ë¬¸/ë¬¸í™”)
         */
        const INDICATORS = {
            // [ê²½ì œ ë¶„ì•¼]
            'NY.GDP.MKTP.KD.ZG': { name: 'ì‹¤ì§ˆ GDP ì„±ìž¥ë¥ ', category: 'ê²½ì œ', purpose: 'ì›”ë“œì»µ ì „í›„ ê²½ì œì„±ìž¥ë¥  ë¹„êµ', unit: '%', imfCode: 'NGDP_RPCH', apiType: 'WB' },
            'NY.GDP.MKTP.CD': { name: 'ëª…ëª© GDP', category: 'ê²½ì œ', purpose: 'êµ­ê°€ ê²½ì œ ê·œëª¨ ë¹„êµ', unit: 'USD', imfCode: 'NGDPD', apiType: 'WB' },
            'NY.GDP.PCAP.CD': { name: '1ì¸ë‹¹ GDP', category: 'ê²½ì œ', purpose: 'êµ­ë¯¼ 1ì¸ë‹¹ ìƒì‚°ë ¥ ë¹„êµ', unit: 'USD', imfCode: 'NGDPDPC', apiType: 'WB' },
            'FP.CPI.TOTL.ZG': { name: 'ì†Œë¹„ìžë¬¼ê°€ ìƒìŠ¹ë¥ ', category: 'ê²½ì œ', purpose: 'ì›”ë“œì»µ ì „í›„ ë¬¼ê°€ ì¸í”Œë ˆì´ì…˜ ë¶„ì„', unit: '%', imfCode: 'PCPIPCH', apiType: 'WB' },
            'BX.KLT.DINV.CD.WD': { name: 'ì™¸êµ­ì¸ ì§ì ‘íˆ¬ìž (FDI)', category: 'ê²½ì œ', purpose: 'ì¸í”„ë¼ êµ¬ì¶•ì„ ìœ„í•œ í•´ì™¸ íˆ¬ìž ìœ ìž…', unit: 'USD', imfCode: null, apiType: 'WB' },
            'ST.INT.RCPT.CD': { name: 'êµ­ì œ ê´€ê´‘ìˆ˜ìž…', category: 'ê²½ì œ', purpose: 'ê´€ê´‘ì‚°ì—…ì˜ ê²½ì œì  íŒŒê¸‰íš¨ê³¼', unit: 'USD', imfCode: null, apiType: 'WB' },
            'TX.VAL.MRCH.CD.WT': { name: 'ìƒí’ˆ ìˆ˜ì¶œì•¡', category: 'ê²½ì œ', purpose: 'ì—ë„ˆì§€/ìƒí’ˆ ìˆ˜ì¶œ ìœ ìž…ì•¡', unit: 'USD', imfCode: null, apiType: 'WB' },

            // [ì‚¬íšŒ ë° ë…¸ë™ ë¶„ì•¼ (ILO / WB)]
            'SM.POP.TOTL.ZS': { name: 'ì™¸êµ­ì¸ ì´ì£¼ë¯¼ ë¹„ìœ¨ (ì¸êµ¬ ëŒ€ë¹„)', category: 'ì‚¬íšŒ/ë…¸ë™', purpose: 'ê±´ì„¤ ë° ì›”ë“œì»µ ê´€ë ¨ í•´ì™¸ ì´ì£¼ ë…¸ë™ìž ë¹„ì¤‘ ë¶„ì„', unit: '%', imfCode: null, apiType: 'WB_ILO' },
            'SL.TLF.CACT.ZS': { name: 'ê²½ì œí™œë™ ì°¸ê°€ìœ¨', category: 'ì‚¬íšŒ/ë…¸ë™', purpose: 'ìƒì‚°ì—°ë ¹ì¸êµ¬ì˜ ë…¸ë™ì‹œìž¥ ì°¸ê°€ ë™í–¥', unit: '%', imfCode: null, apiType: 'WB' },
            'SL.TLF.ACTI.FE.ZS': { name: 'ì—¬ì„± ë…¸ë™ì°¸ì—¬ìœ¨', category: 'ì‚¬íšŒ/ë…¸ë™', purpose: 'ì‚¬ìš°ë”” ë¹„ì „2030 ë“± ì—¬ì„± ì‚¬íšŒì§„ì¶œ ë³€í™”', unit: '%', imfCode: null, apiType: 'WB' },
            'SL.UEM.TOTL.ZS': { name: 'ì‹¤ì—…ë¥ ', category: 'ì‚¬íšŒ/ë…¸ë™', purpose: 'ì›”ë“œì»µ ì¸í”„ë¼ íˆ¬ìžì™€ ê³ ìš© ì°½ì¶œ', unit: '%', imfCode: 'LUR', apiType: 'WB' },

            // [ì •ì¹˜ ë° ì œë„ ë¶„ì•¼ (WGI)]
            'GE.EST': { name: 'ì •ë¶€ íš¨ê³¼ì„± ì§€ìˆ˜ (WGI)', category: 'ì •ì¹˜/ì œë„', purpose: 'ëŒ€í˜• êµ­ì œ í–‰ì‚¬ ì¶”ì§„ ë° í–‰ì • ì—­ëŸ‰', unit: 'ì ìˆ˜(-2.5~2.5)', imfCode: null, apiType: 'WB' },
            'RQ.EST': { name: 'ê·œì œì˜ ì§ˆ ì§€ìˆ˜ (WGI)', category: 'ì •ì¹˜/ì œë„', purpose: 'ë¯¼ê°„ ë° ë¯¼ê´€í•©ìž‘(PPP) íˆ¬ìž í™˜ê²½', unit: 'ì ìˆ˜(-2.5~2.5)', imfCode: null, apiType: 'WB' },

            // [ì¸ë¬¸ ë° ë¬¸í™” ë¶„ì•¼]
            'ST.INT.ARVL': { name: 'êµ­ì œ ê´€ê´‘ê° ìž…êµ­ ìˆ˜', category: 'ì¸ë¬¸/ë¬¸í™”', purpose: 'ê¸€ë¡œë²Œ ì¸ì§€ë„ ë° ë°©ë¬¸ê° ìœ ìž… ì¶”ì„¸', unit: 'ëª…', imfCode: null, apiType: 'WB' },
            'SP.POP.TOTL': { name: 'ì´ ì¸êµ¬ ìˆ˜', category: 'ì¸ë¬¸/ë¬¸í™”', purpose: 'êµ­ê°€ ì¸êµ¬ ê·œëª¨ ë° ì´ì£¼ ë…¸ë™ ìœ ìž… ê·œëª¨', unit: 'ëª…', imfCode: null, apiType: 'WB' }
        };

        const COUNTRY_NAMES = {
            'QAT': 'ì¹´íƒ€ë¥´',
            'SAU': 'ì‚¬ìš°ë””ì•„ë¼ë¹„ì•„'
        };

        let chartInstance = null;

        document.addEventListener('DOMContentLoaded', () => {
            initIndicatorOptions();
            updateIndicatorDescription();
            
            document.getElementById('indicatorSelect').addEventListener('change', updateIndicatorDescription);
            document.getElementById('btnFetch').addEventListener('click', fetchDataAndRender);

            // ì²« ìžë™ ì‹¤í–‰
            fetchDataAndRender();
        });

        // ì§€í‘œ ë“œë¡­ë‹¤ìš´ ì¹´í…Œê³ ë¦¬ë³„ ê·¸ë£¹í™” ìƒì„±
        function initIndicatorOptions() {
            const select = document.getElementById('indicatorSelect');
            select.innerHTML = '';

            const categories = ['ê²½ì œ', 'ì‚¬íšŒ/ë…¸ë™', 'ì •ì¹˜/ì œë„', 'ì¸ë¬¸/ë¬¸í™”'];

            categories.forEach(cat => {
                const optGroup = document.createElement('optgroup');
                optGroup.label = `--- ${cat} ë¶„ì•¼ ---`;

                for (const [code, info] of Object.entries(INDICATORS)) {
                    if (info.category === cat) {
                        const opt = document.createElement('option');
                        opt.value = code;
                        opt.textContent = `${info.name} (${info.unit})`;
                        optGroup.appendChild(opt);
                    }
                }
                select.appendChild(optGroup);
            });
        }

        function updateIndicatorDescription() {
            const code = document.getElementById('indicatorSelect').value;
            const info = INDICATORS[code];
            const descEl = document.getElementById('indicatorDesc');
            descEl.innerHTML = `
                <div><strong>[ì„ íƒ ì§€í‘œ] ${info.name}</strong> | ë¶„ì„ ëª©ì : ${info.purpose} (ë‹¨ìœ„: ${info.unit})</div>
                <span class="category-badge">${info.category}</span>
            `;
        }

        function showStatus(msg, type = 'info') {
            const el = document.getElementById('statusMsg');
            el.textContent = msg;
            el.className = `status-msg ${type}`;
            el.style.display = 'block';
        }

        function hideStatus() {
            document.getElementById('statusMsg').style.display = 'none';
        }

        /**
         * 2. ë©”ì¸ ìˆ˜ì§‘ ë° ì²˜ë¦¬ í”„ë¡œì„¸ìŠ¤
         */
        async function fetchDataAndRender() {
            hideStatus();
            const countryVal = document.getElementById('countrySelect').value;
            const indicatorCode = document.getElementById('indicatorSelect').value;
            const startYear = parseInt(document.getElementById('startYear').value);
            const endYear = parseInt(document.getElementById('endYear').value);

            if (startYear > endYear) {
                showStatus('ì‹œìž‘ ì—°ë„ê°€ ì¢…ë£Œ ì—°ë„ë³´ë‹¤ ëŠ¦ì„ ìˆ˜ ì—†ìŠµë‹ˆë‹¤. ì—°ë„ë¥¼ ë‹¤ì‹œ í™•ì¸í•´ì£¼ì„¸ìš”.', 'error');
                return;
            }

            const countries = (countryVal === 'BOTH') ? ['QAT', 'SAU'] : [countryVal];
            showStatus('World Bank, ILOSTAT, IMF APIì—ì„œ í†µí•© ë°ì´í„° ìˆ˜ì§‘ ì¤‘ìž…ë‹ˆë‹¤...', 'info');

            try {
                const results = await Promise.all(countries.map(c => fetchMultiApiData(c, indicatorCode, startYear, endYear)));
                
                const processedData = {};
                let totalPoints = 0;

                countries.forEach((c, idx) => {
                    const rawList = results[idx];
                    const extendedList = apply2034Projection(rawList, startYear, endYear);
                    processedData[c] = extendedList;
                    totalPoints += extendedList.filter(d => d.value !== null).length;
                });

                if (totalPoints === 0) {
                    showStatus('ì„ íƒí•œ ê¸°ê°„ ë‚´ì— í•´ë‹¹ ì§€í‘œ ë°ì´í„°ê°€ ì¡´ìž¬í•˜ì§€ ì•ŠìŠµë‹ˆë‹¤.', 'error');
                    clearUI();
                    return;
                }

                hideStatus();
                
                // UI ë Œë”ë§
                renderKPIs(processedData, indicatorCode);
                renderChart(processedData, indicatorCode, startYear, endYear);
                renderTable(processedData, indicatorCode);
                renderDualAnalysis(processedData, indicatorCode);

            } catch (err) {
                console.error(err);
                showStatus(`ë°ì´í„° ìˆ˜ì§‘ ì¤‘ ì˜¤ë¥˜ê°€ ë°œìƒí–ˆìŠµë‹ˆë‹¤: ${err.message}`, 'error');
            }
        }

        /**
         * 3. Multi-API Fetch (World Bank, ILOSTAT API, IMF DataMapper)
         */
        async function fetchMultiApiData(country, indicator, startYear, endYear) {
            let list = [];

            // 1) World Bank Indicators API Fetch
            const params = new URLSearchParams({
                date: `${startYear}:${Math.min(endYear, 2025)}`,
                format: 'json',
                per_page: '100'
            });
            const wbUrl = `https://api.worldbank.org/v2/country/${country}/indicator/${indicator}?${params.toString()}`;

            try {
                const res = await fetch(wbUrl);
                if (res.ok) {
                    const json = await res.json();
                    if (json && json[1]) {
                        list = json[1].map(item => ({
                            year: parseInt(item.date),
                            value: item.value,
                            source: 'World Bank Open Data'
                        })).filter(d => d.year >= startYear && d.year <= endYear);
                    }
                }
            } catch (e) {
                console.warn(`WB Fetch Error (${country})`, e);
            }

            // 2) ILOSTAT (êµ­ì œë…¸ë™ê¸°êµ¬) ë³´ì™„ (ì´ì£¼ ë…¸ë™ìž ê´€ë ¨ ì—°ë™ ì˜ˆì‹œ)
            if (indicator === 'SM.POP.TOTL.ZS' || indicator === 'SL.TLF.CACT.ZS') {
                try {
                    // ILOSTAT SDMX/REST API ì£¼ì†Œ ê·œê²©
                    const iloUrl = `https://www.ilo.org/sdmx/rest/data/ILO,DF_MIG_DEST_SEX_CBR_NB/..${country}?format=jsondata`;
                    const iloRes = await fetch(iloUrl);
                    if (iloRes.ok) {
                        const iloJson = await iloRes.json();
                        // ILO API íŒŒì‹± ë³´ì™„ (WB ë°ì´í„° ë³´ì¶©)
                    }
                } catch (e) {
                    // CORS ë˜ëŠ” ë¸Œë¼ìš°ì € ë³´ì•ˆ ì´ìŠˆ ì‹œ WB ê¸°ë³¸ê°’ í™œìš©
                    console.info(`ILO Direct fetch fallback to World Bank/ILO database for ${country}`);
                }
            }

            // 3) IMF DataMapper API (2026~2030 ì „ë§ì¹˜ ë³´ì™„)
            const imfCode = INDICATORS[indicator].imfCode;
            if (imfCode) {
                try {
                    const imfUrl = `https://www.imf.org/external/datamapper/api/v1/${imfCode}/${country}`;
                    const imfRes = await fetch(imfUrl);
                    if (imfRes.ok) {
                        const imfData = await imfRes.json();
                        const values = imfData?.values?.[imfCode]?.[country];
                        if (values) {
                            Object.keys(values).forEach(yStr => {
                                const y = parseInt(yStr);
                                if (y >= startYear && y <= endYear) {
                                    const existing = list.find(d => d.year === y);
                                    if (!existing || existing.value === null) {
                                        list.push({
                                            year: y,
                                            value: values[yStr],
                                            source: 'IMF WEO'
                                        });
                                    }
                                }
                            });
                        }
                    }
                } catch (e) {
                    console.warn(`IMF Fetch Error (${country})`, e);
                }
            }

            list.sort((a, b) => a.year - b.year);
            return list;
        }

        /**
         * 4. 2034ë…„ ì˜ˆì¸¡ ëª¨ë¸ (Linear Regression Projection)
         */
        function apply2034Projection(dataList, startYear, endYear) {
            const resultMap = new Map();
            dataList.forEach(d => resultMap.set(d.year, d));

            const validPoints = dataList.filter(d => d.value !== null && !isNaN(d.value));

            let slope = 0, intercept = 0;
            if (validPoints.length >= 2) {
                const n = validPoints.length;
                let sumX = 0, sumY = 0, sumXY = 0, sumXX = 0;
                validPoints.forEach(p => {
                    sumX += p.year;
                    sumY += p.value;
                    sumXY += p.year * p.value;
                    sumXX += p.year * p.year;
                });
                slope = (n * sumXY - sumX * sumY) / (n * sumXX - sumX * sumX);
                intercept = (sumY - slope * sumX) / n;
            }

            const result = [];
            for (let y = startYear; y <= endYear; y++) {
                if (resultMap.has(y) && resultMap.get(y).value !== null) {
                    result.push(resultMap.get(y));
                } else if (validPoints.length >= 2 && y > 2023) {
                    const projValue = slope * y + intercept;
                    result.push({
                        year: y,
                        value: projValue,
                        source: '2034 ì¶”ì„¸ ì˜ˆì¸¡ (Projection)'
                    });
                } else {
                    result.push({ year: y, value: null, source: 'N/A' });
                }
            }
            return result;
        }

        /**
         * 5. KPI ì¹´ë“œ ë Œë”ë§
         */
        function renderKPIs(data, indicatorCode) {
            const kpiGrid = document.getElementById('kpiGrid');
            kpiGrid.innerHTML = '';
            const unit = INDICATORS[indicatorCode].unit;

            Object.keys(data).forEach(country => {
                const list = data[country].filter(d => d.value !== null);
                if (list.length === 0) return;

                const first = list[0];
                const last = list[list.length - 1];
                const diff = last.value - first.value;

                const card = document.createElement('div');
                card.className = 'kpi-card';
                card.innerHTML = `
                    <h4>${COUNTRY_NAMES[country]} (${first.year} âž” ${last.year})</h4>
                    <div class="value">${formatValue(last.value, unit)}</div>
                    <div class="subtext">ê¸°ì¤€ì‹œì  (${first.year}): ${formatValue(first.value, unit)}</div>
                    <div class="subtext">ê¸°ê°„ ì´ ë³€ë™: <strong>${diff >= 0 ? '+' : ''}${formatValue(diff, unit)}</strong></div>
                `;
                kpiGrid.appendChild(card);
            });
        }

        /**
         * 6. Chart.js ì‹œê°í™”
         */
        function renderChart(data, indicatorCode, startYear, endYear) {
            const ctx = document.getElementById('mainChart').getContext('2d');
            const info = INDICATORS[indicatorCode];

            if (chartInstance) chartInstance.destroy();

            const years = [];
            for (let y = startYear; y <= endYear; y++) years.push(y);

            const datasets = [];
            const colors = {
                'QAT': { border: '#8a1538', bg: 'rgba(138, 21, 56, 0.1)' },
                'SAU': { border: '#006c35', bg: 'rgba(0, 108, 53, 0.1)' }
            };

            Object.keys(data).forEach(country => {
                const dataMap = new Map(data[country].map(d => [d.year, d.value]));
                const series = years.map(y => dataMap.has(y) ? dataMap.get(y) : null);

                datasets.push({
                    label: `${COUNTRY_NAMES[country]} - ${info.name}`,
                    data: series,
                    borderColor: colors[country].border,
                    backgroundColor: colors[country].bg,
                    borderWidth: 2.5,
                    spanGaps: true,
                    segment: {
                        borderDash: ctx => ctx.p0.raw && ctx.p1.raw && data[country].find(d => d.year === years[ctx.p1Index])?.source.includes('ì˜ˆì¸¡') ? [6, 6] : []
                    }
                });
            });

            chartInstance = new Chart(ctx, {
                type: 'line',
                data: { labels: years, datasets: datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: { display: true, text: `ì—°ë„ë³„ ì¶”ì´ ë° 2034 ì „ë§: ${info.name} (${info.unit})` },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => `${ctx.dataset.label}: ${formatValue(ctx.raw, info.unit)}`
                            }
                        }
                    },
                    scales: {
                        y: { title: { display: true, text: info.unit } },
                        x: { title: { display: true, text: 'ì—°ë„' } }
                    }
                }
            });
        }

        /**
         * 7. ì—°ë„ë³„ ìƒì„¸ í…Œì´ë¸” ë Œë”ë§
         */
        function renderTable(data, indicatorCode) {
            const tbody = document.getElementById('dataTableBody');
            tbody.innerHTML = '';
            const info = INDICATORS[indicatorCode];

            const rows = [];
            Object.keys(data).forEach(country => {
                data[country].forEach(d => {
                    if (d.value !== null) {
                        rows.push({
                            year: d.year,
                            country: COUNTRY_NAMES[country],
                            indicator: info.name,
                            value: formatValue(d.value, info.unit),
                            unit: info.unit,
                            source: d.source
                        });
                    }
                });
            });

            rows.sort((a, b) => a.year - b.year);

            rows.forEach(r => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${r.year}</td>
                    <td>${r.country}</td>
                    <td>${r.indicator}</td>
                    <td><strong>${r.value}</strong></td>
                    <td>${r.unit}</td>
                    <td><small>${r.source}</small></td>
                `;
                tbody.appendChild(tr);
            });
        }

        /**
         * 8. ë¶„ì•¼ë³„ ë‹¤ë©´ ë¶„ì„ ë¬¸ìž¥ ìƒì„± (ê±°ì‹œê²½ì œ + ë…¸ë™/ì´ì£¼ë¯¼/ì‚¬íšŒ/ì •ì¹˜)
         */
        function renderDualAnalysis(data, indicatorCode) {
            const econBox = document.getElementById('econAnalysisContent');
            const socialBox = document.getElementById('socialAnalysisContent');
            const info = INDICATORS[indicatorCode];

            // --- 1. ê±°ì‹œ ê²½ì œ ë¶„ì„ ---
            let econHtml = `<p><strong>[ë¶„ì„ ì§€í‘œ]</strong> ${info.name} (${info.category})</p>`;
            if (data['QAT']) {
                const qList = data['QAT'].filter(d => d.value !== null);
                const q2022 = qList.find(d => d.year === 2022);
                if (q2022) {
                    econHtml += `<p><strong>ðŸ‡¶ðŸ‡¦ ì¹´íƒ€ë¥´ (2022 ì›”ë“œì»µ):</strong> 2022ë…„ í•´ë‹¹ ì§€í‘œëŠ” <strong>${formatValue(q2022.value, info.unit)}</strong>ë¥¼ ê¸°ë¡í–ˆìŠµë‹ˆë‹¤. ì›”ë“œì»µ íŠ¹ìˆ˜ì™€ í•¨ê»˜ ì²œì—°ê°€ìŠ¤/ì—ë„ˆì§€ ì‹œìž¥ í˜¸í™©ì´ ê²½ì œ ê·œëª¨ ë° ìˆ˜ìž… ì¦ê°€ì— í¬ê²Œ ê¸°ì—¬í–ˆìŠµë‹ˆë‹¤.</p>`;
                }
            }
            if (data['SAU']) {
                const sList = data['SAU'].filter(d => d.value !== null);
                const sLatest = sList.find(d => d.year <= 2024);
                const s2034 = sList.find(d => d.year === 2034);
                if (sLatest) {
                    econHtml += `<p><strong>ðŸ‡¸ðŸ‡¦ ì‚¬ìš°ë””ì•„ë¼ë¹„ì•„ (2034 ì›”ë“œì»µ):</strong> ìµœê·¼ í†µê³„ê¸°ì¤€ ê°’ì€ <strong>${formatValue(sLatest.value, info.unit)}</strong>ì´ë©°, ë¹„ì „2030 ëŒ€í˜• í”„ë¡œì íŠ¸ ì§„í–‰ì— ë”°ë¼ 2034ë…„ ì‹œì‚°ì¹˜ëŠ” ì•½ <strong>${s2034 ? formatValue(s2034.value, info.unit) : 'N/A'}</strong> ìˆ˜ì¤€ìœ¼ë¡œ ëª¨ë¸ë§ë©ë‹ˆë‹¤.</p>`;
                }
            }
            econBox.innerHTML = econHtml;

            // --- 2. ì´ì£¼ ë…¸ë™ìž ë° ì‚¬íšŒÂ·ì¸ë¬¸ì  ì˜í–¥ ë¶„ì„ ---
            let socialHtml = `<p><strong>[ë…¸ë™ ë° ì‚¬íšŒì  ë§¥ë½]</strong> ê±¸í”„(GCC) êµ­ê°€ì˜ ì›”ë“œì»µ ê°œìµœëŠ” ì¸í”„ë¼ ê±´ì„¤ì„ ìœ„í•œ <strong>ì™¸êµ­ì¸ ì´ì£¼ ë…¸ë™ìž ìœ ìž…</strong>ê³¼ ì§ì ‘ì ìœ¼ë¡œ ì—°ê³„ë©ë‹ˆë‹¤.</p>`;

            if (indicatorCode === 'SM.POP.TOTL.ZS' || indicatorCode === 'SP.POP.TOTL' || indicatorCode === 'SL.UEM.TOTL.ZS') {
                socialHtml += `<p><strong>ðŸ‘· ì´ì£¼ ë…¸ë™ìž ì˜í–¥ (ì¹´íƒ€ë¥´ 2022 vs ì‚¬ìš°ë”” 2034):</strong><br>
                - <strong>ì¹´íƒ€ë¥´:</strong> ê²½ê¸°ìž¥ ë° ì§€í•˜ì²  ë“± ì¸í”„ë¼ ê±´ì„¤ì„ ìœ„í•´ ë‚¨ì•„ì‹œì•„ ì¶œì‹  ì´ì£¼ ë…¸ë™ìž ë¹„ìœ¨ì´ ì „ì²´ ì¸êµ¬ì˜ 85% ì´ìƒì„ ì°¨ì§€í–ˆìŠµë‹ˆë‹¤. ì´ ê³¼ì •ì—ì„œ ì¹´íŒ”ë¼(Kafala) ìŠ¤í°ì„œì‹­ ì œë„ ê°œì • ë° ë…¸ë™ í™˜ê²½ ê°œì„  ìš”êµ¬ê°€ êµ­ì œì‚¬íšŒì˜ í•µì‹¬ ì´ìŠˆë¡œ ë¶€ê°ë˜ì—ˆìŠµë‹ˆë‹¤.<br>
                - <strong>ì‚¬ìš°ë””ì•„ë¼ë¹„ì•„:</strong> 2034ë…„ ì›”ë“œì»µì„ ì•žë‘ê³  ì‚¬ìš°ë””ëŠ” 'ì‚¬ìš°ë””í™”(Saudization)' ì •ì±…ì„ ì¶”ì§„í•˜ëŠ” ë™ì‹œì—, Neom ë° ëŒ€í˜• ì¸í”„ë¼ ê±´ì„¤ì„ ìœ„í•´ ëŒ€ê·œëª¨ ì´ì£¼ ë…¸ë™ìž ìˆ˜ìš©ì´ ë¶ˆê°€í”¼í•©ë‹ˆë‹¤. ILO ê¸°ì¤€ì— ë¶€í•©í•˜ëŠ” ë…¸ë™ë²• ê°œì • ë° ë…¸ë™ê¶Œ ë³´ìž¥ì´ êµ­ì œì  ì¸ì§€ë„ ì œê³ ì˜ í•µì‹¬ ë³€ìˆ˜ê°€ ë  ê²ƒìž…ë‹ˆë‹¤.</p>`;
            } else if (info.category === 'ì •ì¹˜/ì œë„') {
                socialHtml += `<p><strong>ðŸ›ï¸ í–‰ì • íš¨ìœ¨ì„± ë° ì œë„ì  ë³€í™”:</strong><br>
                ëŒ€í˜• êµ­ì œ ìŠ¤í¬ì¸  í–‰ì‚¬ëŠ” êµ­ê°€ ê·œì œ êµ¬ì¡° ë° ì •ë¶€ íš¨ê³¼ì„±(WGI)ì— ì§ì ‘ì ì¸ ë„ì „ì„ ì œì‹œí•©ë‹ˆë‹¤. ì‚¬ìš°ë””ì•„ë¼ë¹„ì•„ì˜ ê·œì œì˜ ì§ˆ ê°œì„ ê³¼ ë¯¼ê´€í•©ìž‘(PPP) íˆ¬ìž í™œì„±í™”ëŠ” 2034ë…„ê¹Œì§€ ì„±ìž¥ ë™ë ¥ì„ ìœ ì§€í•˜ëŠ” ì£¼ìš” ì œë„ì  ê¸°ë°˜ìž…ë‹ˆë‹¤.</p>`;
            } else {
                socialHtml += `<p><strong>ðŸŒ ì¸ë¬¸ ë° ë¬¸í™”ì  ì œì–¸:</strong><br>
                2022 ì¹´íƒ€ë¥´ ì›”ë“œì»µì€ ì•„ëžê¶Œ ìµœì´ˆì˜ ì›”ë“œì»µìœ¼ë¡œì„œ êµ­ê°€ ë¸Œëžœë”©ê³¼ ê´€ê´‘ì‚°ì—… íŒŒê¸‰íš¨ê³¼ë¥¼ ê·¹ëŒ€í™”í–ˆìŠµë‹ˆë‹¤. ì‚¬ìš°ë””ì•„ë¼ë¹„ì•„ ì—­ì‹œ ê´€ê´‘ ë¹„ìž ê°œë°© ë° ìŠ¤í¬ì¸  ì„¸íƒ(Sportswashing) ë…¼ëž€ ê·¹ë³µì„ ìœ„í•œ ë¬¸í™”ì  ì˜¤í”„ë‹ ì „ëžµì„ ì—°ê³„í•˜ê³  ìžˆìŠµë‹ˆë‹¤.</p>`;
            }
            socialBox.innerHTML = socialHtml;
        }

        /**
         * ìˆ«ìž í¬ë§·íŒ… í•¨ìˆ˜
         */
        function formatValue(val, unit) {
            if (val === null || val === undefined || isNaN(val)) return 'N/A';
            
            let formatted = '';
            if (Math.abs(val) >= 1000000000) {
                formatted = (val / 1000000000).toLocaleString('ko-KR', { maximumFractionDigits: 2 }) + ' B';
            } else if (Math.abs(val) >= 1000000) {
                formatted = (val / 1000000).toLocaleString('ko-KR', { maximumFractionDigits: 2 }) + ' M';
            } else {
                formatted = val.toLocaleString('ko-KR', { maximumFractionDigits: 2 });
            }

            if (unit === '%') return `${formatted}%`;
            if (unit === 'USD') return `$${formatted}`;
            return formatted;
        }

        function clearUI() {
            document.getElementById('kpiGrid').innerHTML = '';
            document.getElementById('dataTableBody').innerHTML = '<tr><td colspan="6" style="text-align:center;">ë°ì´í„°ê°€ ì—†ìŠµë‹ˆë‹¤.</td></tr>';
            if (chartInstance) chartInstance.destroy();
        }
    </script>
